generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  RECRUITER
  FINANCE
  OPERATIONS
  EMPLOYER
  TALENT
}

enum HireInquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum ServiceType {
  DIRECT_RECRUITMENT
  MANAGED_STAFFING
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum RoleFamily {
  OFFICE_PROFESSIONAL
  SKILLED_TRADE
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CandidateScreenStatus {
  NEW
  SCREENING
  SCREENED
  REJECTED
}

enum CandidateDocumentKind {
  CV
  CERTIFICATE
  OTHER
}

enum NewsletterCampaignStatus {
  DRAFT
  SENT
}

enum NewsletterSendStatus {
  QUEUED
  SENT
  FAILED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ApiKeyEnvironment {
  LIVE
  TEST
}

enum ApiKeyPlan {
  SANDBOX
  PARTNER
  ENTERPRISE
}

model User {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  email                String    @unique
  passwordHash         String?
  firstName            String
  lastName             String
  googleId             String?   @unique
  avatarUrl            String?
  authProvider         String    @default("local")
  isEmailVerified      Boolean   @default(false)
  isActive             Boolean   @default(true)
  emailVerifyToken     String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  roles                   UserRoleAssignment[]
  refreshTokens           RefreshToken[]
  organizationMemberships OrganizationMember[]
  auditLogs               AuditLog[]
  candidate               Candidate?
  supportTickets          SupportTicket[]      @relation("TicketRequester")
  assignedTickets         SupportTicket[]      @relation("TicketAssignee")
  ticketMessages          SupportTicketMessage[]
  apiKeysCreated          ApiKey[]             @relation("ApiKeyCreator")
  webhookEndpoints        WebhookEndpoint[]    @relation("WebhookOwner")
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        UserRole @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRoleAssignment[]
}

model Permission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String   @db.ObjectId
  permissionId String   @db.ObjectId
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  roleId    String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Organization {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       OrganizationMember[]
  hireInquiries HireInquiry[]
  apiKeys       ApiKey[]
}

model OrganizationMember {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  userId         String   @db.ObjectId
  title          String?
  isOwner        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model HireInquiry {
  id                      String            @id @default(auto()) @map("_id") @db.ObjectId
  companyName             String
  contactName             String
  email                   String
  phone                   String
  roleFamily              RoleFamily        @default(OFFICE_PROFESSIONAL)
  serviceType             ServiceType
  roleTitle               String
  numberOfProfessionals   Int
  location                String
  workArrangement         WorkArrangement
  expectedStartDate       String?
  compensationMinMinor    Int?
  compensationMaxMinor    Int?
  currency                String            @default("NGN")
  durationNotes           String?
  requirements            String
  additionalNotes         String?
  status                  HireInquiryStatus @default(NEW)
  organizationId          String?           @db.ObjectId
  apiKeyId                String?           @db.ObjectId
  isTest                  Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  shortlists   Shortlist[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([apiKeyId])
}

model BlogPost {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String         @unique
  excerpt        String
  content        String
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  authorId       String?        @db.ObjectId
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
}

model Candidate {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  email        String
  phone        String?
  roleTitle    String?
  location     String?
  notes        String?
  screenStatus CandidateScreenStatus @default(NEW)
  userId       String?               @unique @db.ObjectId
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user             User?                @relation(fields: [userId], references: [id])
  shortlistEntries ShortlistEntry[]
  documents        CandidateDocument[]

  @@index([email])
  @@index([screenStatus])
}

model CandidateDocument {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String                @db.ObjectId
  kind        CandidateDocumentKind @default(OTHER)
  fileName    String
  mimeType    String
  byteSize    Int
  url         String
  publicId    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
}

model Shortlist {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  hireInquiryId String   @db.ObjectId
  title         String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hireInquiry HireInquiry     @relation(fields: [hireInquiryId], references: [id])
  entries     ShortlistEntry[]

  @@index([hireInquiryId])
}

model ShortlistEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  shortlistId String   @db.ObjectId
  candidateId String   @db.ObjectId
  rank        Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shortlist Shortlist @relation(fields: [shortlistId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([shortlistId, candidateId])
}

model NewsletterSubscriber {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  firstName   String?
  roleSegment String   @default("ALL")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterCampaign {
  id          String                    @id @default(auto()) @map("_id") @db.ObjectId
  subject     String
  bodyHtml    String
  bodyText    String?
  segment     String                    @default("ALL")
  status      NewsletterCampaignStatus  @default(DRAFT)
  sentAt      DateTime?
  createdById String?                   @db.ObjectId
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  sends NewsletterSend[]
}

model NewsletterSend {
  id         String               @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String               @db.ObjectId
  email      String
  status     NewsletterSendStatus @default(QUEUED)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime             @default(now())

  campaign NewsletterCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  subject      String
  body         String
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(NORMAL)
  category     String                @default("general")
  requesterId  String                @db.ObjectId
  assigneeId   String?               @db.ObjectId
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  resolvedAt   DateTime?

  requester User                   @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages  SupportTicketMessage[]

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

model SupportTicketMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String   @db.ObjectId
  authorId   String   @db.ObjectId
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

model ApiKey {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  keyPrefix       String
  keyHash         String            @unique
  environment     ApiKeyEnvironment @default(TEST)
  plan            ApiKeyPlan        @default(SANDBOX)
  scopes          String[]
  rateLimitPerMin Int               @default(60)
  isActive        Boolean           @default(true)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  createdByUserId String            @db.ObjectId
  organizationId  String?           @db.ObjectId
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  createdBy    User          @relation("ApiKeyCreator", fields: [createdByUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  usageLogs    ApiUsageLog[]
  oauthClients OAuthClient[]

  @@index([keyPrefix])
  @@index([createdByUserId])
  @@index([isActive])
}

model ApiUsageLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  apiKeyId   String   @db.ObjectId
  method     String
  path       String
  statusCode Int
  latencyMs  Int
  createdAt  DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, createdAt])
}

/// OAuth2 client-credentials client; tokens act with the backing API key's plan, limits and (narrowed) scopes.
model OAuthClient {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  clientId         String    @unique
  clientSecretHash String
  apiKeyId         String    @db.ObjectId
  isActive         Boolean   @default(true)
  lastUsedAt       DateTime?
  createdByUserId  String    @db.ObjectId
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookEndpoint {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  url            String
  description    String?
  /// Signing secret; needed in plaintext to compute HMAC signatures.
  secret         String
  events         String[]
  isActive       Boolean   @default(true)
  isGlobal       Boolean   @default(false)
  ownerUserId    String    @db.ObjectId
  organizationId String?   @db.ObjectId
  failureCount   Int       @default(0)
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner      User              @relation("WebhookOwner", fields: [ownerUserId], references: [id])
  deliveries WebhookDelivery[]

  @@index([ownerUserId])
  @@index([organizationId])
  @@index([isActive, isGlobal])
}

model WebhookDelivery {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  endpointId    String                @db.ObjectId
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  responseCode  Int?
  responseBody  String?
  error         String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
}
