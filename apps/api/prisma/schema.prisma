generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  RECRUITER
  FINANCE
  OPERATIONS
  EMPLOYER
  TALENT
}

enum HireInquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum ServiceType {
  DIRECT_RECRUITMENT
  MANAGED_STAFFING
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum RoleFamily {
  OFFICE_PROFESSIONAL
  SKILLED_TRADE
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CandidateScreenStatus {
  NEW
  SCREENING
  SCREENED
  REJECTED
}

enum CandidateDocumentKind {
  CV
  CERTIFICATE
  OTHER
}

enum NewsletterCampaignStatus {
  DRAFT
  SENT
}

enum NewsletterSendStatus {
  QUEUED
  SENT
  FAILED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ApiKeyEnvironment {
  LIVE
  TEST
}

enum ApiKeyPlan {
  SANDBOX
  PARTNER
  ENTERPRISE
}

model User {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  email                String    @unique
  passwordHash         String?
  firstName            String
  lastName             String
  /// Not @unique: MongoDB unique indexes count missing values, so a second password-only account would be refused.
  googleId             String?
  linkedinId           String?
  avatarUrl            String?
  authProvider         String    @default("local")
  isEmailVerified      Boolean   @default(false)
  isActive             Boolean   @default(true)
  emailVerifyToken     String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  /// Optional so accounts created before lockouts still load.
  failedLoginCount     Int?
  lockedUntil          DateTime?
  /// Job-seeker premium (resume builder). Granted by admins until Paystack plans launch.
  premiumUntil         DateTime?
  /// True for a new Google/LinkedIn account until the person confirms their role and name.
  onboardingPending    Boolean?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  notifications           Notification[]
  resumes                 Resume[]
  roles                   UserRoleAssignment[]
  refreshTokens           RefreshToken[]
  organizationMemberships OrganizationMember[]
  auditLogs               AuditLog[]
  candidate               Candidate?
  supportTickets          SupportTicket[]      @relation("TicketRequester")
  assignedTickets         SupportTicket[]      @relation("TicketAssignee")
  ticketMessages          SupportTicketMessage[]
  apiKeysCreated          ApiKey[]             @relation("ApiKeyCreator")
  webhookEndpoints        WebhookEndpoint[]    @relation("WebhookOwner")
  apiSubscription         ApiSubscription?     @relation("ApiSubscriber")
  apiInvoices             ApiInvoice[]         @relation("ApiInvoiceOwner")

  @@index([googleId])
  @@index([linkedinId])
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  /// Dotted event name, e.g. hire_request.created or ats.application.created.
  type      String
  title     String
  body      String?
  /// In-app path the notification opens.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        UserRole @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRoleAssignment[]
}

model Permission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String   @db.ObjectId
  permissionId String   @db.ObjectId
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  roleId    String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Organization {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String   @unique
  isActive       Boolean  @default(true)
  logoUrl        String?
  website        String?
  about          String?
  brandColor     String?
  careersEnabled Boolean  @default(true)
  plan           String   @default("EARLY_ACCESS")
  maxOpenJobs    Int      @default(10)
  maxSeats       Int      @default(10)
  /// Hiring Agents plan: FREE or PRO (PRO lapses back to FREE after agentPlanUntil).
  agentPlan      String    @default("FREE")
  agentPlanUntil DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members       OrganizationMember[]
  hireInquiries HireInquiry[]
  apiKeys       ApiKey[]
  invites       WorkspaceInvite[]
  jobs          Job[]
  applications  Application[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  RECRUITER
  HIRING_MANAGER
}

model OrganizationMember {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @db.ObjectId
  userId         String        @db.ObjectId
  title          String?
  isOwner        Boolean       @default(false)
  role           WorkspaceRole @default(RECRUITER)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model HireInquiry {
  id                      String            @id @default(auto()) @map("_id") @db.ObjectId
  companyName             String
  contactName             String
  email                   String
  phone                   String
  roleFamily              RoleFamily        @default(OFFICE_PROFESSIONAL)
  serviceType             ServiceType
  roleTitle               String
  numberOfProfessionals   Int
  location                String
  workArrangement         WorkArrangement
  expectedStartDate       String?
  compensationMinMinor    Int?
  compensationMaxMinor    Int?
  currency                String            @default("NGN")
  durationNotes           String?
  requirements            String
  additionalNotes         String?
  status                  HireInquiryStatus @default(NEW)
  organizationId          String?           @db.ObjectId
  apiKeyId                String?           @db.ObjectId
  isTest                  Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  shortlists   Shortlist[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([apiKeyId])
}

model BlogPost {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String         @unique
  excerpt        String
  content        String
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  status         BlogPostStatus @default(DRAFT)
  category       String?
  tags           String[]
  featured       Boolean        @default(false)
  publishedAt    DateTime?
  authorId       String?        @db.ObjectId
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
}

model Candidate {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  email        String
  phone        String?
  roleTitle    String?
  location     String?
  notes        String?
  screenStatus CandidateScreenStatus @default(NEW)
  userId       String?               @unique @db.ObjectId
  headline         String?
  bio              String?
  skills           String[]
  yearsExperience  Int?
  roleFamily       RoleFamily?
  availability     String?
  expectedPayMinor Int?
  linkedinUrl      String?
  portfolioUrl     String?
  openToWork       Boolean               @default(true)
  profileUpdatedAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user             User?                @relation(fields: [userId], references: [id])
  shortlistEntries ShortlistEntry[]
  documents        CandidateDocument[]
  placements       Placement[]

  @@index([email])
  @@index([screenStatus])
}

model CandidateDocument {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String                @db.ObjectId
  kind        CandidateDocumentKind @default(OTHER)
  fileName    String
  mimeType    String
  byteSize    Int
  url         String
  publicId    String
  /// "cloudinary" or "database" (fallback when Cloudinary is not configured).
  storage     String                @default("cloudinary")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  candidate Candidate              @relation(fields: [candidateId], references: [id])
  blob      CandidateDocumentBlob?

  @@index([candidateId])
}

model CandidateDocumentBlob {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId String   @unique @db.ObjectId
  data       Bytes
  createdAt  DateTime @default(now())

  document CandidateDocument @relation(fields: [documentId], references: [id])
}

model Shortlist {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  hireInquiryId String   @db.ObjectId
  title         String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hireInquiry HireInquiry     @relation(fields: [hireInquiryId], references: [id])
  entries     ShortlistEntry[]

  @@index([hireInquiryId])
}

model ShortlistEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  shortlistId String   @db.ObjectId
  candidateId String   @db.ObjectId
  rank        Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shortlist Shortlist @relation(fields: [shortlistId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([shortlistId, candidateId])
}

model NewsletterSubscriber {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  firstName   String?
  roleSegment String   @default("ALL")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Someone who asked not to get newsletters or broadcasts. Covers subscribers and account holders alike.
model EmailOptOut {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  /// "link" (footer), "one_click" (mail app button), "preferences" or "admin".
  source    String   @default("link")
  reason    String?
  campaignId String? @db.ObjectId
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterCampaign {
  id          String                    @id @default(auto()) @map("_id") @db.ObjectId
  subject     String
  bodyHtml    String
  bodyText    String?
  segment     String                    @default("ALL")
  status      NewsletterCampaignStatus  @default(DRAFT)
  sentAt      DateTime?
  createdById String?                   @db.ObjectId
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  sends NewsletterSend[]
}

model NewsletterSend {
  id         String               @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String               @db.ObjectId
  email      String
  status     NewsletterSendStatus @default(QUEUED)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime             @default(now())

  campaign NewsletterCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  subject      String
  body         String
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(NORMAL)
  category     String                @default("general")
  requesterId  String                @db.ObjectId
  assigneeId   String?               @db.ObjectId
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  resolvedAt   DateTime?

  requester User                   @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages  SupportTicketMessage[]

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

model SupportTicketMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String   @db.ObjectId
  authorId   String   @db.ObjectId
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

model ApiKey {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  keyPrefix       String
  keyHash         String            @unique
  environment     ApiKeyEnvironment @default(TEST)
  plan            ApiKeyPlan        @default(SANDBOX)
  scopes          String[]
  rateLimitPerMin Int               @default(60)
  isActive        Boolean           @default(true)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  createdByUserId String            @db.ObjectId
  organizationId  String?           @db.ObjectId
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  createdBy    User          @relation("ApiKeyCreator", fields: [createdByUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  usageLogs    ApiUsageLog[]
  oauthClients OAuthClient[]

  @@index([keyPrefix])
  @@index([createdByUserId])
  @@index([isActive])
}

model ApiUsageLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  apiKeyId   String   @db.ObjectId
  method     String
  path       String
  statusCode Int
  latencyMs  Int
  createdAt  DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, createdAt])
}

/// OAuth2 client-credentials client; tokens act with the backing API key's plan, limits and (narrowed) scopes.
model OAuthClient {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  clientId         String    @unique
  clientSecretHash String
  apiKeyId         String    @db.ObjectId
  isActive         Boolean   @default(true)
  lastUsedAt       DateTime?
  createdByUserId  String    @db.ObjectId
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId])
}

/// Admin-editable pricing and limits per API plan (amounts in minor units, e.g. kobo).
model ApiPlanConfig {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  plan            ApiKeyPlan @unique
  name            String
  description     String?
  priceMinor      Int
  currency        String     @default("NGN")
  periodDays      Int        @default(30)
  rateLimitPerMin Int
  monthlyQuota    Int
  maxLiveKeys     Int        @default(0)
  isPurchasable   Boolean    @default(true)
  updatedAt       DateTime   @updatedAt
  createdAt       DateTime   @default(now())
}

enum ApiSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model ApiSubscription {
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  userId             String                @unique @db.ObjectId
  plan               ApiKeyPlan
  status             ApiSubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user     User         @relation("ApiSubscriber", fields: [userId], references: [id])
  invoices ApiInvoice[]

  @@index([status, currentPeriodEnd])
}

enum ApiInvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model ApiInvoice {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  reference      String           @unique
  userId         String           @db.ObjectId
  subscriptionId String?          @db.ObjectId
  plan           ApiKeyPlan
  amountMinor    Int
  currency       String
  periodDays     Int
  status         ApiInvoiceStatus @default(PENDING)
  provider       String           @default("paystack")
  providerTxnId  String?
  authorizationUrl String?
  paidAt         DateTime?
  failureReason  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User             @relation("ApiInvoiceOwner", fields: [userId], references: [id])
  subscription ApiSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

// --------------------------------------------------------------------- ATS

model WorkspaceInvite {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @db.ObjectId
  email          String
  role           WorkspaceRole @default(RECRUITER)
  tokenHash      String        @unique
  invitedById    String        @db.ObjectId
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

model Job {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String          @db.ObjectId
  title            String
  slug             String
  roleFamily       RoleFamily      @default(OFFICE_PROFESSIONAL)
  location         String
  workArrangement  WorkArrangement @default(ONSITE)
  employmentType   String          @default("FULL_TIME")
  salaryMinMinor   Int?
  salaryMaxMinor   Int?
  currency         String          @default("NGN")
  description      String
  mustHaves        String[]
  stages           String[]
  status           JobStatus       @default(DRAFT)
  hiringManagerIds String[]        @db.ObjectId
  hireInquiryId    String?         @db.ObjectId
  createdById      String          @db.ObjectId
  publishedAt      DateTime?
  closedAt         DateTime?
  /// Questions and scoring guide from the interview kit agent.
  interviewKit     Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  applications Application[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
}

model Application {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String            @db.ObjectId
  jobId          String            @db.ObjectId
  name           String
  email          String
  phone          String?
  location       String?
  coverNote      String?
  answers        Json?
  source         String            @default("careers")
  stage          String
  stageChangedAt DateTime          @default(now())
  status         ApplicationStatus @default(ACTIVE)
  rating         Int?
  tags           String[]
  aiScore        Int?
  aiFit          String?
  aiRunId        String?           @db.ObjectId
  userId         String?           @db.ObjectId
  cvFileId       String?           @db.ObjectId
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  job          Job                @relation(fields: [jobId], references: [id])
  events       ApplicationEvent[]
  interviews   Interview[]
  scorecards   Scorecard[]
  offers       Offer[]

  @@unique([jobId, email])
  @@index([organizationId, jobId, stage])
  @@index([organizationId, createdAt])
}

model AtsFile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  fileName       String
  mimeType       String
  byteSize       Int
  storage        String   @default("database")
  url            String?
  publicId       String?
  data           Bytes?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

/// A CV or cover letter made in the resume builder. `data` follows the shared zod schema for its kind.
model Resume {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  kind             String    @default("RESUME")
  title            String
  template         String    @default("classic")
  accentColor      String    @default("#0f766e")
  font             String    @default("helvetica")
  data             Json
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, kind])
}

// -------------------------------------------------------------- hiring agents

model AgentSetting {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @db.ObjectId
  agent          String
  enabled        Boolean   @default(false)
  config         Json?
  lastRunAt      DateTime?
  updatedById    String?   @db.ObjectId
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, agent])
  @@index([agent, enabled])
}

/// One piece of agent work: a suggestion or draft waiting for a person, or a finished report.
model AgentTask {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @db.ObjectId
  agent          String
  kind           String
  status         String    @default("PENDING")
  title          String
  summary        String
  payload        Json
  jobId          String?   @db.ObjectId
  applicationId  String?   @db.ObjectId
  trigger        String    @default("on_demand")
  provider       String    @default("rules")
  result         String?
  createdById    String?   @db.ObjectId
  decidedById    String?   @db.ObjectId
  decidedByName  String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, agent, createdAt])
  @@index([organizationId, jobId, agent, status])
}

model AgentUsage {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String @db.ObjectId
  /// "2026-11", in Lagos time.
  month          String
  runs           Int    @default(0)

  @@unique([organizationId, month])
}

model AgentInvoice {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  reference        String    @unique
  organizationId   String    @db.ObjectId
  userId           String    @db.ObjectId
  amountMinor      Int
  currency         String
  periodDays       Int
  status           String    @default("PENDING")
  authorizationUrl String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([organizationId, createdAt])
}

/// One online payment for CV builder Premium (job seekers). Moves PENDING -> PAID/FAILED once.
model ResumeInvoice {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  reference        String    @unique
  userId           String    @db.ObjectId
  amountMinor      Int
  currency         String
  periodDays       Int
  status           String    @default("PENDING")
  authorizationUrl String?
  providerTxnId    String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Every Paystack webhook we receive, kept for audit and so a repeated event is handled once.
model PaymentEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  provider   String   @default("paystack")
  /// Provider event name plus the transaction id, e.g. "charge.success:123456".
  eventKey   String   @unique
  event      String
  reference  String?
  product    String?
  status     String   @default("RECEIVED")
  error      String?
  receivedAt DateTime @default(now())

  @@index([reference])
  @@index([receivedAt])
}

/// Job pulled from a public job feed (Remotive, Jobicy, Arbeitnow, Jooble, Careerjet). Applying always happens on `url`.
model ExternalJob {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  source         String
  sourceId       String
  title          String
  company        String
  companyLogo    String?
  location       String
  remote         Boolean  @default(true)
  employmentType String   @default("FULL_TIME")
  category       String?
  tags           String[]
  salaryText     String?
  /// Sanitised HTML from the feed.
  description    String
  summary        String
  url            String
  publishedAt    DateTime
  fetchedAt      DateTime @default(now())

  @@unique([source, sourceId])
  @@index([publishedAt])
}

model JobFeedSync {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  source    String    @unique
  lastRunAt DateTime?
  lastOkAt  DateTime?
  lastCount Int       @default(0)
  lastError String?
}

/// `listingId` is "dealo_<jobId>" or "ext_<externalJobId>"; title/company are kept so the entry survives the listing.
model SavedJob {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  listingId String
  title     String
  company   String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model JobApplicationLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  listingId String
  title     String
  company   String
  url       String
  source    String
  resumeId  String?  @db.ObjectId
  status    String   @default("APPLIED")
  note      String?
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, listingId])
  @@index([userId, appliedAt])
}

/// Reusable email a workspace sends to applicants. Supports {{firstName}}, {{jobTitle}}, {{company}}.
model AtsEmailTemplate {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  name           String
  subject        String
  body           String
  createdById    String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model ApplicationEvent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  applicationId  String   @db.ObjectId
  type           String
  actorId        String?  @db.ObjectId
  actorName      String?
  body           String?
  meta           Json?
  createdAt      DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId, createdAt])
}

enum InterviewStatus {
  PROPOSED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Interview {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String          @db.ObjectId
  applicationId    String          @db.ObjectId
  kind             String          @default("VIDEO")
  status           InterviewStatus @default(PROPOSED)
  startsAt         DateTime?
  durationMin      Int             @default(30)
  slotOptions      DateTime[]
  location         String?
  interviewerIds   String[]        @db.ObjectId
  bookingTokenHash String?
  notes            String?
  createdById      String          @db.ObjectId
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id])

  @@index([organizationId, startsAt])
  @@index([applicationId])
  @@index([bookingTokenHash])
}

model Scorecard {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  applicationId  String   @db.ObjectId
  reviewerId     String   @db.ObjectId
  reviewerName   String
  rating         Int
  recommendation String
  criteria       Json?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, reviewerId])
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Offer {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String      @db.ObjectId
  applicationId     String      @db.ObjectId
  payMinor          Int
  currency          String      @default("NGN")
  payPeriod         String      @default("MONTH")
  startDate         DateTime
  notes             String?
  status            OfferStatus @default(DRAFT)
  responseTokenHash String?
  sentAt            DateTime?
  respondedAt       DateTime?
  responseNote      String?
  createdById       String      @db.ObjectId
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  application Application @relation(fields: [applicationId], references: [id])

  @@index([organizationId, status])
  @@index([responseTokenHash])
}

// ---------------------------------------------------------------------- AI

/// Every AI suggestion is stored so a person can review it and we can audit it.
model AiRun {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  feature      String
  subjectType  String
  subjectId    String?
  provider     String
  model        String?
  output       Json
  latencyMs    Int
  status       String    @default("SUGGESTED")
  reviewedById String?   @db.ObjectId
  reviewedAt   DateTime?
  reviewNote   String?
  createdById  String    @db.ObjectId
  createdAt    DateTime  @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([feature, createdAt])
}

// ---------------------------------------------------------------- workforce ops

enum PlacementStatus {
  ACTIVE
  ENDED
}

enum AttendanceKind {
  CHECK_IN
  CHECK_OUT
}

enum CoverRequestStatus {
  OPEN
  FILLED
  CANCELLED
  BREACHED
}

/// A place people work at, with a geofence used to validate check-ins.
model WorkSite {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  address        String?
  latitude       Float
  longitude      Float
  radiusMeters   Int      @default(200)
  timezone       String   @default("Africa/Lagos")
  /// Local shift times as "HH:mm".
  shiftStart     String   @default("07:30")
  shiftEnd       String   @default("17:30")
  graceMinutes   Int      @default(15)
  slaCoverHours  Int      @default(48)
  isActive       Boolean  @default(true)
  organizationId String?  @db.ObjectId
  hireInquiryId  String?  @db.ObjectId
  createdById    String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  placements    Placement[]
  attendance    AttendanceEvent[]
  coverRequests CoverRequest[]
  events        OpsEvent[]

  @@index([isActive])
  @@index([organizationId])
}

model Placement {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  siteId      String          @db.ObjectId
  candidateId String          @db.ObjectId
  roleTitle   String
  isStandby   Boolean         @default(false)
  status      PlacementStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  site       WorkSite          @relation(fields: [siteId], references: [id])
  candidate  Candidate         @relation(fields: [candidateId], references: [id])
  attendance AttendanceEvent[]

  @@index([siteId, status])
  @@index([candidateId, status])
}

model AttendanceEvent {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  placementId    String         @db.ObjectId
  siteId         String         @db.ObjectId
  kind           AttendanceKind
  /// Local calendar date at the site, "YYYY-MM-DD".
  workDate       String
  occurredAt     DateTime       @default(now())
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  distanceMeters Int?
  withinGeofence Boolean
  lateMinutes    Int            @default(0)
  source         String         @default("app")

  placement Placement @relation(fields: [placementId], references: [id])
  site      WorkSite  @relation(fields: [siteId], references: [id])

  @@index([siteId, workDate])
  @@index([placementId, workDate])
}

model CoverRequest {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  siteId             String             @db.ObjectId
  absentPlacementId  String             @db.ObjectId
  standbyPlacementId String?            @db.ObjectId
  workDate           String
  reason             String
  status             CoverRequestStatus @default(OPEN)
  openedAt           DateTime           @default(now())
  dueBy              DateTime
  filledAt           DateTime?
  filledById         String?            @db.ObjectId

  site WorkSite @relation(fields: [siteId], references: [id])

  @@unique([absentPlacementId, workDate])
  @@index([siteId, status])
  @@index([status, dueBy])
}

/// Human-readable activity feed for a site (agent, staff and worker actions).
model OpsEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  siteId    String   @db.ObjectId
  type      String
  severity  String   @default("info")
  actor     String   @default("agent")
  title     String
  detail    String?
  meta      Json?
  createdAt DateTime @default(now())

  site WorkSite @relation(fields: [siteId], references: [id])

  @@index([siteId, createdAt])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookEndpoint {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  url            String
  description    String?
  /// Signing secret; needed in plaintext to compute HMAC signatures.
  secret         String
  events         String[]
  isActive       Boolean   @default(true)
  isGlobal       Boolean   @default(false)
  ownerUserId    String    @db.ObjectId
  organizationId String?   @db.ObjectId
  failureCount   Int       @default(0)
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner      User              @relation("WebhookOwner", fields: [ownerUserId], references: [id])
  deliveries WebhookDelivery[]

  @@index([ownerUserId])
  @@index([organizationId])
  @@index([isActive, isGlobal])
}

model WebhookDelivery {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  endpointId    String                @db.ObjectId
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  responseCode  Int?
  responseBody  String?
  error         String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
}
