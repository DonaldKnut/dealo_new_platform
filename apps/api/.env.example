NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Paste your MongoDB Atlas connection string here (no local replicaSet needed for Atlas)
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER/dealo_db?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32+
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32+
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
# Leave COOKIE_DOMAIN unset: the website forwards /api/v1 to this API, so cookies belong to the website.
# COOKIE_DOMAIN=
# Proxies in front of the API. Behind Vercel (website proxy) + Render, use 2.
TRUST_PROXY=1

# Optional — "Continue with Google" and "Continue with LinkedIn". See docs/SIGN_IN_SETUP.md.
# Callback URLs default to <APP_URL>/api/v1/auth/google/callback and <APP_URL>/api/v1/auth/linkedin/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_CALLBACK_URL=

DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos

EMAIL_FROM="Dealo <onboarding@resend.dev>"
EMAIL_PROVIDER=auto
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional — required for talent document uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — richer AI agents (screening, sourcing, ops briefs, blog drafts).
# Without a key the agents run on built-in rules. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional — switches on every online payment: API plans, Hiring Agents Pro, and Dealo Premium (CV + Job Agent).
# Use sk_test_… / pk_test_… while testing, sk_live_… / pk_live_… when you go live. Keys must match mode.
# See docs/PAYMENTS_SETUP.md. Webhook URL: <SITE_URL>/api/v1/payments/paystack/webhook
# Leave blank until you paste real keys — checkout returns a clear “payments not on” error until then.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Dealo Premium (one Paystack product): unlocks CV fonts/templates/AI + Job Agent limits.
# Price in kobo (250000 = ₦2,500) and how many days one payment lasts.
CV_PREMIUM_PRICE_MINOR=250000
CV_PREMIUM_DAYS=30

# Optional — Nigerian jobs on the job board. Each source switches on when its key is set.
# Jooble: free key at https://ng.jooble.org/api/about (request it on the Nigeria site)  ·  Careerjet: free affiliate ID at https://www.careerjet.com.ng/partners/
JOOBLE_API_KEY=
CAREERJET_AFFID=
